# Security-Header für Cloudflare Pages.
# Format: Pfad-Muster, darunter eingerückt die Header.
#
# Zur CSP-Entscheidung: script-src/style-src brauchen 'unsafe-inline', weil
# die ganze App bewusst als eine Datei mit inline <style>/<script> gebaut ist
# (keine externen Dateien, keine Frameworks). Die saubere Alternative wären
# SHA-256-Hashes je Inline-Block — die müssten aber bei JEDER Code-Änderung
# neu berechnet und hier eingetragen werden, sonst geht die Seite still
# kaputt. Für ein Ein-Personen-Projekt ist das Risiko-/Wartungsverhältnis
# schlecht. Der Rest der CSP bleibt deshalb bewusst eng: keine externen
# Skripte, keine fremden Verbindungsziele, kein Einbetten in fremde Seiten.
#
# connect-src listet die tatsächlich genutzten Ziele: den eigenen Proxy
# (WebUntis + Mensamax laufen über ihn) und ccCampus (läuft technisch bedingt
# direkt aus dem Browser). Nutzt jemand eine ccCampus-Instanz unter einer
# anderen Domain als *.mbs5online.de, muss sie hier ergänzt werden.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stundenplan-proxy.bluedemann.workers.dev https://*.mbs5online.de; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
